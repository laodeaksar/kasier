# TEMPLATE KONFIGURASI KASIER
# Salin file ini menjadi .env, lalu ganti semua nilai placeholder di bawah.
# Jangan mengirim atau mengunggah .env ke Git; file .env sudah dikecualikan oleh .gitignore.

# Alamat koneksi PostgreSQL (Neon).
# Ambil connection string dari dashboard database Neon. Biasanya dimulai dengan
# postgresql:// atau postgres:// dan sudah menyertakan sslmode=require.
# URL-encode karakter khusus pada bagian password sesuai format URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Kunci rahasia Better Auth untuk menandatangani/melindungi sesi login.
# Buat nilai acak yang panjang (minimal 32 karakter), misalnya dengan:
# openssl rand -base64 32
# Jangan gunakan contoh ini sebagai kunci sebenarnya dan jangan bagikan nilainya.
BETTER_AUTH_SECRET=GANTI_DENGAN_KUNCI_ACAK_PANJANG_MINIMAL_32_KARAKTER

# Alamat dasar aplikasi yang dipakai Better Auth.
# Untuk komputer sendiri, gunakan alamat lokal ini. Untuk Preview/deploy HTTPS,
# ganti dengan URL HTTPS aplikasi yang benar.
BETTER_AUTH_URL=http://localhost:3000

# Email akun pemilik pertama yang akan dibuat oleh perintah pnpm db:seed.
# Gunakan email yang Anda pilih; ini bukan akun yang sudah dibuat otomatis.
OWNER_EMAIL=pemilik@example.com

# Kata sandi akun pemilik pertama untuk proses seed.
# Pilih kata sandi kuat minimal 8 karakter dan simpan dengan aman.
OWNER_PASSWORD=GANTI_DENGAN_KATA_SANDI_KUAT

# Nama yang ditampilkan untuk akun pemilik pertama.
OWNER_NAME=Nama Pemilik
